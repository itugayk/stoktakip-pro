# ============================================
# StokTakip Pro — Environment Variables
# Copy this to .env.local and fill in your values
# ============================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Only needed for server-side admin operations (never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_NAME=StokTakip Pro
# Local browser: http://localhost:3000
# Phone/LAN browser: use the URL printed by `pnpm dev:lan`, for example http://192.168.1.25:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: If NEXT_PUBLIC_SUPABASE_URL contains "placeholder", the app runs in DEMO MODE
# with sample data and no real authentication required.
